# ---------------------------------------------------------------------------
# custops — example environment. Copy to .env and edit.
#   cp .env.example .env          (bash)
#   Copy-Item .env.example .env   (PowerShell)
#
# .env is gitignored and must never contain a real credential that matters.
# Every value here is read through Pydantic Settings (src/custops/config.py);
# nothing in the codebase reads os.environ directly.
# ---------------------------------------------------------------------------

# ── Application ────────────────────────────────────────────────────────────
CUSTOPS_ENVIRONMENT=local
CUSTOPS_DEBUG=false
# Per-dependency timeout for /health probes, in seconds.
CUSTOPS_HEALTH_PROBE_TIMEOUT_SECONDS=2.0

# ── PostgreSQL (source of truth; hosts the pgvector extension) ─────────────
# Local native install  -> POSTGRES_HOST=localhost
# Docker Compose        -> POSTGRES_HOST=postgres   (the compose service name)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=custops
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=custops

# ── Redis ──────────────────────────────────────────────────────────────────
# Local native install  -> REDIS_HOST=localhost
# Docker Compose        -> REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Leave empty for a local instance with no password configured.
REDIS_PASSWORD=

# ── Logging ────────────────────────────────────────────────────────────────
# LOG_FORMAT=json for machine-readable output (required in any deployed
# environment); LOG_FORMAT=console for human-readable local development.
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Authentication (§17, Phase 13)
# ---------------------------------------------------------------------------
# There is no token in this file, and there never should be. Credentials are
# minted per user and shown exactly once:
#
#   uv run custops issue-token --email ops.approver@custops.example.com --label laptop
#
# Only the SHA-256 hash is stored. A lost token is replaced, not recovered:
#
#   uv run custops revoke-token --token-id <id>
#
# Callers present it as:  Authorization: Bearer custops_...
