# Normalise line endings. Shell scripts must keep LF even when checked out on
# Windows: a CRLF entrypoint.sh fails inside a Linux container with the famously
# unhelpful "no such file or directory" (the interpreter path picks up the \r).
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
